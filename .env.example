# ============================================================
# WidgetPilot dev 环境配置（M01 §4.3 env 契约）
# 用法：cp .env.example .env
# 变量名与生产 Helm values 同 schema，dev 与 prod 只允许值不同。
# 密钥不入库：本文件只含占位值；dev 默认密码仅限本地使用。
# ============================================================

# --- compose 分组（§4.3）---
# 可选值组合：core | core observability | core full | core sandbox
COMPOSE_PROFILES=core
COMPOSE_PROJECT_NAME=widgetpilot-dev

# Windows 路径兼容（bind mount 用正斜杠）
COMPOSE_CONVERT_WINDOWS_PATHS=1

# --- Postgres（§4.3）---
POSTGRES_USER=widgetpilot
POSTGRES_PASSWORD=widgetpilot_dev   # 仅限本地，禁止上生产
POSTGRES_DB=widgetpilot
POSTGRES_PORT=5432
# 本机直连模式（默认）指向 127.0.0.1；full 模式由 compose 覆写为 postgres:5432
DATABASE_URL=postgresql+asyncpg://widgetpilot:widgetpilot_dev@127.0.0.1:5432/widgetpilot

# --- Redis（§4.3）---
REDIS_URL=redis://127.0.0.1:6379/0

# --- 对象存储 MinIO（S3 兼容，§4.3）---
S3_ENDPOINT=http://127.0.0.1:9000
S3_ACCESS_KEY=wpdev
S3_SECRET_KEY=wpdev-secret          # 仅限本地，禁止上生产
S3_BUCKET=wp-dev

# --- 观测 OTel（§4.3）---
# observability profile 未启动时服务需容忍不可达（M11 §2.3 本地缓冲降级）
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318

# --- JWT（§4.3，M04 消费）---
JWT_SECRET=change-me-dev-only       # 仅限本地，生产值只存于生产密钥管理
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# --- 运行环境（§4.3）---
ENV=dev
LOG_LEVEL=INFO

# --- 前端（§4.3）---
VITE_API_BASE=http://127.0.0.1:8000

# --- 可选端口覆写（端口冲突时改这里，port_check 会检测）---
# GRAFANA_PORT=3000

# 注意：模型 API 密钥类不提供——本地开发用 Fake DecisionSource（M04 §8.1）
