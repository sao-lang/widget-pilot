{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://widgetpilot.dev/schemas/events.schema.json",
  "title": "AgentEvent",
  "description": "M02 §4.5 实时事件协议。可靠性约定：Last-Event-ID 续传 + 服务端保留最近 N 条（Q4 定稿 500，影子校准中）、超窗先拉快照；心跳保活；显式 done/error（无 done 视为截断）；前端按 seq 去重与乱序丢弃。未知 kind 容忍扩展（I6，前端 reducer 忽略而非报错）。M02 §9.0 义务2/3：error/notice payload 已按 M06 §4.2 固化，discriminator 以 kind 的 const 值作锚点，顶层 kind 的强制由 allOf/if/then 执行。",
  "type": "object",
  "required": ["seq", "sessionId", "runId", "ts", "kind", "phase", "payload", "traceId"],
  "additionalProperties": false,
  "properties": {
    "seq": { "type": "integer", "minimum": 0, "description": "每会话单调递增；续传/去重游标" },
    "sessionId": { "type": "string", "minLength": 1 },
    "runId": { "type": "string", "minLength": 1, "description": "重连与跨天恢复的锚点" },
    "ts": { "type": "string", "format": "date-time", "description": "UTC 带时区" },
    "kind": {
      "description": "AgentEventKind；未知值容忍（向前兼容）",
      "enum": ["run", "plan", "spec", "attachment", "routing", "code", "guard", "validation", "sandbox", "artifact", "cost", "checkpoint", "interrupted", "notice", "error", "done", "ask_user", "reasoning", "agent_message", "review", "delegate"]
    },
    "phase": {
      "description": "SessionState 权威状态",
      "enum": ["DRAFT", "RUNNING", "PAUSED", "AWAITING_INPUT", "VALIDATING", "COMPLETED", "FAILED", "CANCELLED"]
    },
    "payload": {
      "description": "按 kind 收窄（discriminated union）：各对象分支以 kind 的 const 值作 discriminator 锚点；顶层 kind 的强制由事件级 allOf/if/then 执行。字符串分支为宽松兜底（plan / 未收窄消费者）。final spec 用 widget_spec.schema.json 严格校验；partial tolerant",
      "oneOf": [
        { "type": "object", "properties": { "kind": { "const": "run" }, "runId": { "type": "string" }, "phase": { "type": "string" }, "grid": { "$ref": "#/$defs/gridSpec" }, "attempt_no": { "type": "integer", "minimum": 0 } }, "required": ["runId", "phase", "grid"] },
        { "type": "string", "description": "plan：结论式短句（不是思维链）；未收窄 payload 的宽松兜底" },
        { "type": "object", "description": "plan：ADR-006 约束式规划的 TaskPlanDraft（规划器产出，零模型 PlanValidator 校验后发）", "properties": { "kind": { "const": "plan" }, "tasks": { "type": "array", "items": { "type": "object", "properties": { "index": { "type": "integer", "minimum": 1 }, "description": { "type": "string", "minLength": 1 }, "grid": { "$ref": "#/$defs/gridSpec" }, "attachment_ids": { "type": "array", "items": { "type": "string" } }, "rationale": { "type": "string" } }, "required": ["index", "description"] } }, "ambiguous_reason": { "type": "string" }, "plan_trace_ref": { "type": "string" } }, "required": ["tasks"] },
        { "type": "object", "description": "guard：M08 出护栏判据结论", "properties": { "kind": { "const": "guard" }, "hit": { "type": "boolean" }, "judge": { "type": "string", "enum": ["schema", "capability_allowlist", "forbidden_content", "pii", "intent_match", "spec_consistency"] }, "reason_code": { "$ref": "#/$defs/reasonCode" }, "source_ref": { "type": "string" } }, "required": ["hit", "judge"] },
        { "type": "object", "description": "sandbox：M08 一次性沙箱逐条断言结论", "properties": { "kind": { "const": "sandbox" }, "case_name": { "type": "string" }, "passed": { "type": "boolean" }, "detail_ref": { "type": "string" }, "reason_code": { "$ref": "#/$defs/reasonCode" } }, "required": ["case_name", "passed"] },
        { "type": "object", "description": "reasoning：ADR-008 受控推理摘要（严禁原始 CoT）", "properties": { "kind": { "const": "reasoning" }, "summary": { "type": "string" }, "source": { "type": "string", "enum": ["provider", "harness"] } }, "required": ["summary"] },
        { "type": "object", "description": "agent_message：ADR-007 中心路由类型化消息留证", "properties": { "kind": { "const": "agent_message" }, "message_type": { "type": "string", "enum": ["TASK_ASSIGN", "REVIEW_REQUEST", "REVIEW_RESULT", "REVISION_REQUEST", "ESCALATE_HUMAN", "FINAL"] }, "from_role": { "type": "string" }, "to_role": { "type": "string" }, "rev": { "type": "integer" }, "trace_id": { "type": "string" } }, "required": ["message_type", "from_role", "to_role"] },
        { "type": "object", "description": "review：Reviewer 角色结构化评审结论", "properties": { "kind": { "const": "review" }, "passed": { "type": "boolean" }, "reason_code": { "$ref": "#/$defs/reasonCode" }, "evidence_ref": { "type": "string" }, "artifact_ref": { "type": "string" }, "score": { "type": "number" } }, "required": ["passed"] },
        { "type": "object", "description": "delegate：角色委托/返修指令", "properties": { "kind": { "const": "delegate" }, "action": { "type": "string", "enum": ["REVISION_REQUEST", "ESCALATE_HUMAN"] }, "reason_code": { "$ref": "#/$defs/reasonCode" } }, "required": ["action"] },
        { "type": "object", "description": "spec：逐步逼近完整的 WidgetSpec JSON（partial；不携带 reason code）", "properties": { "kind": { "const": "spec" } }, "not": { "required": ["code"] } },
        { "type": "object", "description": "attachment：附件 role 判定", "properties": { "kind": { "const": "attachment" }, "role": { "enum": ["visual_reference", "content_extraction", "data_source", "style_reference"] }, "insight_ref": { "type": "string" } }, "required": ["role"] },
        { "type": "object", "description": "routing：代码补丁路由", "properties": { "kind": { "const": "routing" }, "patches": { "type": "array", "items": { "type": "object", "properties": { "from_line": { "type": "integer", "minimum": 0 }, "to_line": { "type": "integer", "minimum": 0 }, "text": { "type": "string" } }, "required": ["from_line", "to_line", "text"] } } }, "required": ["patches"] },
        { "type": "object", "description": "validation：结果校验", "properties": { "kind": { "const": "validation" }, "passed_items": { "type": "array", "items": { "type": "string" } }, "hit_items": { "type": "array", "items": { "type": "string" } }, "reason_code": { "$ref": "#/$defs/reasonCode" } }, "required": ["passed_items"] },
        { "type": "object", "description": "artifact：产物引用", "properties": { "kind": { "const": "artifact" }, "bundle_id": { "type": "string", "minLength": 1 }, "preview_ref": { "type": "string" } }, "required": ["bundle_id"] },
        { "type": "object", "description": "cost：用量计费", "properties": { "kind": { "const": "cost" }, "amount": { "type": "number" }, "ledger_ref": { "type": "string" } }, "required": ["amount"] },
        { "type": "object", "description": "checkpoint：检查点", "properties": { "kind": { "const": "checkpoint" }, "rev": { "type": "integer" }, "node": { "type": "string" }, "state_blob_ref": { "type": "string" } }, "required": ["rev"] },
        { "type": "object", "description": "interrupted：中断", "properties": { "kind": { "const": "interrupted" }, "reason": { "type": "string" } }, "required": ["reason"] },
        { "type": "object", "description": "notice：规格询问 / 澄清（M06 §4.2 _notice_payload）；spec_missing 与 spec_conflict 结构见 $defs", "properties": { "kind": { "const": "notice" }, "code": { "$ref": "#/$defs/reasonCode" }, "message": { "type": "string" }, "clarify_hint": { "type": "string" }, "spec_missing": { "$ref": "#/$defs/specMissing" }, "spec_conflict": { "$ref": "#/$defs/specConflict" } }, "required": ["code", "message"] },
        { "type": "object", "description": "error：终态失败（M06 §4.2）；evidenceRef 指向带 sha256 的输入快照，必填", "properties": { "kind": { "const": "error" }, "code": { "$ref": "#/$defs/reasonCode" }, "evidenceRef": { "type": "string", "minLength": 1, "description": "指向带 sha256 的输入快照证据引用（§4.4 全局口径）" }, "message": { "type": "string" } }, "required": ["code", "evidenceRef"] }
      ]
    },
    "traceId": { "type": "string", "minLength": 1 },
    "taskId": { "type": "string", "minLength": 1, "description": "ADR-006/007/009：任务级归因；done/error 带此字段=子任务级，不带=会话级（仅 Coordinator 可发）" },
    "taskIndex": { "type": "integer", "minimum": 1, "description": "任务序号（1-based）" },
    "role": { "type": "string", "enum": ["planner", "generator", "reviewer", "coordinator"], "description": "ADR-007 功能角色；Router/Coordinator 不是 agent" },
    "turn": { "type": "integer", "minimum": 1, "description": "任务内轮次 / 迭代序号" },
    "agentId": { "type": "string", "minLength": 1, "description": "一次角色实例的 uuid" }
  },
  "allOf": [
    {
      "description": "discriminator：kind=error 时 payload 必须是 { code, evidenceRef, message? }（M02 §9.0 义务2）",
      "if": { "properties": { "kind": { "const": "error" } }, "required": ["kind"] },
      "then": {
        "properties": {
          "payload": { "$ref": "#/$defs/errorPayload" }
        }
      }
    },
    {
      "description": "discriminator：kind=notice 时 payload 携带 spec_missing / spec_conflict 结构（M02 §9.0 义务3）",
      "if": { "properties": { "kind": { "const": "notice" } }, "required": ["kind"] },
      "then": {
        "properties": {
          "payload": { "$ref": "#/$defs/noticePayload" }
        }
      }
    }
  ],
  "$defs": {
    "reasonCode": {
      "description": "ReasonCode 全集（M02 §5.3）；error.code 必须属于此枚举",
      "enum": ["INPUT_INVALID", "INTENT_OUT_OF_SCOPE", "GUARD_INPUT_HIT", "GUARD_OUTPUT_HIT", "SPEC_CONFLICT", "CAPABILITY_DENIED", "CONTRACT_MISMATCH", "COMPILE_FAILED", "SANDBOX_TEST_FAILED", "RETRY_EXHAUSTED", "BUDGET_EXHAUSTED", "SANDBOX_UNAVAILABLE", "HUMAN_REQUIRED", "MODEL_ERROR", "SPEC_MISSING", "CLARIFICATION_REQUIRED", "CLARIFICATION_LIMIT"]
    },
    "gridSpec": {
      "description": "GridSpec 值域（与 enums.GridSpec 同源）",
      "enum": ["2x2", "2x4", "4x2", "4x4", "2x1", "1x2"]
    },
    "specMissing": {
      "type": "object",
      "description": "规格缺失：建议 grid 列表（M06 _notice_payload 的 spec_missing.suggest_grid: GridSpec[]）",
      "properties": { "suggest_grid": { "type": "array", "items": { "$ref": "#/$defs/gridSpec" } } },
      "required": ["suggest_grid"]
    },
    "specConflict": {
      "type": "object",
      "description": "规格冲突：当前 grid / feature 与建议改选 grid（均为标量，M06 _notice_payload 的 spec_conflict）",
      "properties": {
        "grid": { "$ref": "#/$defs/gridSpec" },
        "feature": { "type": "string" },
        "suggest_grid": { "$ref": "#/$defs/gridSpec" }
      },
      "required": ["grid", "feature", "suggest_grid"]
    },
    "errorPayload": {
      "type": "object",
      "description": "error 事件 payload 结构（§4.2 { code, evidenceRef }）",
      "properties": {
        "code": { "$ref": "#/$defs/reasonCode" },
        "evidenceRef": { "type": "string", "minLength": 1, "description": "指向带 sha256 的输入快照证据引用" },
        "message": { "type": "string" }
      },
      "required": ["code", "evidenceRef"]
    },
    "noticePayload": {
      "type": "object",
      "description": "notice 事件 payload 结构（M06 §4.2 _notice_payload 产出形状）",
      "properties": {
        "code": { "$ref": "#/$defs/reasonCode" },
        "message": { "type": "string" },
        "clarify_hint": { "type": "string" },
        "spec_missing": { "$ref": "#/$defs/specMissing" },
        "spec_conflict": { "$ref": "#/$defs/specConflict" }
      },
      "required": ["code", "message"]
    }
  }
}
